<section class="tta-layout">

  {{#unless configured}}
    <div class="tta-setup">
      <span class="tta-kicker">{{localize "TTA.Calendar.SetupKicker"}}</span>
      <h4>{{localize "TTA.Calendar.SetupHeading"}}</h4>
      <p>{{localize "TTA.Calendar.SetupBody"}} <span class="tta-accented">{{localize "TTA.Calendar.NotesFolderName"}}</span>{{localize "TTA.Calendar.SetupBodyTail"}}</p>
      {{#if canConfigure}}
        <button type="button" class="tta-primary" data-action="openConfig">{{localize "TTA.Config.OpenArrow"}}</button>
      {{else}}
        <span class="tta-muted">{{localize "TTA.Calendar.NotConfiguredPlayer"}}</span>
      {{/if}}
    </div>
  {{else}}

    <header class="tta-header">
      <div class="tta-header-date">
        <span class="tta-current-date">{{currentDateLabel}}</span>
        <span class="tta-current-time">{{currentTimeLabel}}</span>
      </div>

      {{#if currentMoons.length}}
        <ul class="tta-moon-strip" aria-label="{{localize "TTA.Moons.CurrentPhases"}}">
          {{#each currentMoons}}
            <li class="tta-moon-item">
              <span class="tta-moon-disc {{#if waxing}}tta-waxing{{else}}tta-waning{{/if}} {{#if gibbous}}tta-gibbous{{/if}}"
                    style="--tta-moon-color: {{color}}; --tta-illumination: {{illumination}}; --tta-terminator: {{terminator}}"
                    aria-hidden="true"></span>
              {{name}} &middot; {{phaseLabel}}
            </li>
          {{/each}}
        </ul>
      {{/if}}

      <div class="tta-header-actions">
        {{#if canChangeTime}}
          <select class="tta-compact" data-time-preset aria-label="{{localize "TTA.Time.AdvancePresetLabel"}}">
            {{#each timePresets}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          <button type="button" class="tta-primary tta-compact" data-action="advanceTime">{{localize "TTA.Time.Advance"}}</button>
          <button type="button" class="tta-compact" data-action="nextDay">{{localize "TTA.Time.PlusOneDay"}}</button>
          <button type="button" class="tta-compact" data-action="setDate">{{localize "TTA.Time.SetDateEllipsis"}}</button>
        {{/if}}
        {{#if canViewTimeline}}
          <button type="button" class="tta-compact" data-action="openTimeline">{{localize "TTA.Timeline.Open"}} &#x2922;</button>
        {{/if}}
        {{#if canConfigure}}
          <button type="button" class="tta-ghost tta-compact" data-action="openConfig">
            <i class="fa-solid fa-gear" aria-hidden="true"></i> {{localize "TTA.Config.Open"}}
          </button>
        {{/if}}
      </div>
    </header>

    {{!-- The strip sits below the header so that its appearance, which can be
          triggered by any other module changing world time, never moves the
          time controls under the pointer. --}}
    {{#if canChangeTime}}
      {{#if worldTimeOutOfSync}}
        <p class="tta-strip">
          <span>{{localize "TTA.Time.OutOfSync"}}</span>
          <button type="button" class="tta-compact" data-action="acknowledgeWorldTime">{{localize "TTA.Time.Acknowledge"}}</button>
        </p>
      {{/if}}
    {{/if}}

    <div class="tta-main">
      <div class="tta-grid-panel">

        <div class="tta-month-head">
          <div>
            {{#if viewAge}}
              <span class="tta-kicker">{{viewAge.name}} &middot; <span class="tta-num">{{viewAge.startYear}}&ndash;{{viewAge.endYear}}</span></span>
            {{else}}
              <span class="tta-kicker tta-kicker-muted">{{localize "TTA.Ages.NoCurrentAge"}}</span>
            {{/if}}
            <h4>{{viewMonthName}} <span class="tta-view-year tta-num">{{viewYearLabel}}</span></h4>
          </div>

          <nav class="tta-month-nav" aria-label="{{localize "TTA.Calendar.NavLabel"}}">
            <button type="button" class="tta-step" data-action="prevYear"
                    data-tooltip="{{localize "TTA.Calendar.PrevYear"}}" aria-label="{{localize "TTA.Calendar.PrevYear"}}">&laquo;</button>
            <button type="button" class="tta-step" data-action="prevMonth"
                    data-tooltip="{{localize "TTA.Calendar.PrevMonth"}}" aria-label="{{localize "TTA.Calendar.PrevMonth"}}">&lsaquo;</button>
            <button type="button" class="tta-compact" data-action="gotoCurrent">{{localize "TTA.Calendar.Today"}}</button>
            <button type="button" class="tta-step" data-action="nextMonth"
                    data-tooltip="{{localize "TTA.Calendar.NextMonth"}}" aria-label="{{localize "TTA.Calendar.NextMonth"}}">&rsaquo;</button>
            <button type="button" class="tta-step" data-action="nextYear"
                    data-tooltip="{{localize "TTA.Calendar.NextYear"}}" aria-label="{{localize "TTA.Calendar.NextYear"}}">&raquo;</button>
          </nav>
        </div>

        <div class="tta-grid-wrap">
          {{!-- The grid always has exactly as many columns as the world has
                weekdays, however many that is. The weekday names are the grid's
                own header row rather than a separate strip, so they stay
                column-aligned and are announced as the columns' headers. --}}
          <div class="tta-grid" style="--tta-columns: {{weekdayNames.length}}"
               role="grid" aria-label="{{localize "TTA.Calendar.GridCaption"}} {{viewLabel}}">
            <div class="tta-grid-head" role="row">
              {{#each weekdayNames}}
                <div role="columnheader"><abbr title="{{this}}">{{this}}</abbr></div>
              {{/each}}
            </div>

            {{#each weeks}}
              <div class="tta-week" role="row">
                {{#each this}}
                  {{> "modules/sargas-through-the-ages/templates/partials/calendar-day.hbs"}}
                {{/each}}
              </div>
            {{/each}}
          </div>
        </div>

        <div class="tta-legend">
          <span><span class="tta-dot-note" aria-hidden="true"></span>{{localize "TTA.Calendar.LegendNotes"}}</span>
          <span><span class="tta-dot-event" aria-hidden="true"></span>{{localize "TTA.Calendar.LegendEvents"}}</span>
          <button type="button" class="tta-ghost" data-action="openNotesFolder">{{localize "TTA.Calendar.OpenNotesFolder"}} &#x2197;</button>
        </div>
      </div>

      <aside class="tta-detail" aria-label="{{localize "TTA.Calendar.DetailLabel"}}">
        {{> "modules/sargas-through-the-ages/templates/partials/day-detail.hbs"}}
      </aside>
    </div>

    <footer class="tta-footer">
      <span>{{localize "TTA.Calendar.FooterHint"}}</span>
      {{#if moduleVersion}}<span class="tta-num">v{{moduleVersion}}</span>{{/if}}
    </footer>
  {{/unless}}
</section>
