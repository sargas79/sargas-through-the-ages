<div class="tta-form-part">
<div class="tta-form-body">

  {{#if isPromotion}}
    <div class="tta-panel">
      <span class="tta-kicker">{{localize "TTA.EventEditor.PromoteHeading"}}</span>
      <p>{{sourceNote.title}} &mdash; {{sourceNote.authorName}} &middot; <span class="tta-key">{{sourceNote.dateKey}}</span></p>
      <p>{{localize "TTA.EventEditor.PromoteBody"}}</p>
      {{#if sourceExcerpt}}
        <blockquote class="tta-source-excerpt">{{sourceExcerpt}}</blockquote>
      {{/if}}
    </div>
  {{/if}}

  <div class="tta-field">
    <label for="tta-event-title">{{localize "TTA.EventEditor.TitleField"}}</label>
    <input id="tta-event-title" type="text" name="title" value="{{title}}" required
           placeholder="{{localize "TTA.EventEditor.TitlePlaceholder"}}">
  </div>

  <div class="tta-field-grid tta-field-grid-date">
    <div class="tta-field">
      <label for="tta-event-year">{{localize "TTA.Common.Year"}}</label>
      <input id="tta-event-year" type="number" name="year" min="1" step="1" value="{{year}}" required>
    </div>
    <div class="tta-field">
      <label for="tta-event-month">{{localize "TTA.Common.Month"}}</label>
      <select id="tta-event-month" name="month">
        {{#each monthChoices}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="tta-field">
      <label for="tta-event-day">{{localize "TTA.Common.Day"}}</label>
      <input id="tta-event-day" type="number" name="day" min="1" max="{{maxDay}}" step="1" value="{{day}}" required>
    </div>
  </div>

  <div class="tta-field">
    <span id="tta-event-description-label">{{localize "TTA.EventEditor.DescriptionField"}}</span>
    <div data-editor-host class="tta-editor-host" aria-labelledby="tta-event-description-label"></div>
  </div>

  <div class="tta-field-grid">
    <div class="tta-field">
      <label for="tta-event-visibility">{{localize "TTA.EventEditor.VisibilityField"}}</label>
      {{!-- A disabled control is not submitted, so a locked visibility travels
            in a hidden input; the service enforces it either way. --}}
      <select id="tta-event-visibility" {{#if visibilityLocked}}disabled{{else}}name="visibility"{{/if}}>
        {{#each visibilityChoices}}
          <option value="{{value}}" {{#if (ttaEq value ../visibility)}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      {{#if visibilityLocked}}
        <input type="hidden" name="visibility" value="{{visibility}}">
        <p class="tta-hint">{{localize "TTA.EventEditor.PlayerNoteVisibilityHint"}}</p>
      {{/if}}
    </div>

    <div class="tta-field">
      <span>{{localize "TTA.EventEditor.ColorField"}}</span>
      {{!-- The swatches are shortcuts into the colour input beside them, which
            stays the field that is actually submitted. --}}
      <div class="tta-swatches">
        {{#each colorSwatches}}
          <button type="button" class="tta-swatch" data-action="pickColor" data-color="{{this}}"
                  style="--tta-tint: {{this}}" data-tooltip="{{this}}" aria-label="{{this}}"></button>
        {{/each}}
        <input type="color" name="color" value="{{color}}" aria-label="{{localize "TTA.EventEditor.ColorField"}}">
      </div>
    </div>

    <div class="tta-field">
      <span>{{localize "TTA.EventEditor.IconField"}}</span>
      <div class="tta-icon-picker" role="radiogroup" aria-label="{{localize "TTA.EventEditor.IconField"}}">
        {{#each iconChoices}}
          <label class="tta-icon-cell" data-tooltip="{{value}}">
            <input type="radio" name="icon" value="{{value}}" {{#if selected}}checked{{/if}}>
            <i class="{{value}}" aria-hidden="true"></i>
            <span class="tta-sr-only">{{value}}</span>
          </label>
        {{/each}}
      </div>
    </div>
  </div>

  {{#if isPromotion}}
    <label class="tta-checkbox">
      <input type="checkbox" name="shareNote">
      <span>{{localize "TTA.EventEditor.ShareSourceNote"}}</span>
    </label>
    <p class="tta-hint">{{localize "TTA.EventEditor.ShareSourceHint"}}</p>
  {{/if}}
</div>

<footer class="tta-form-footer">
  <button type="submit" class="tta-primary">
    {{#if event}}{{localize "TTA.Common.SaveChanges"}}{{else}}{{localize "TTA.EventEditor.Create"}}{{/if}}
  </button>
</footer>
</div>
