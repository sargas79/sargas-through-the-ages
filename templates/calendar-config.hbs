<div class="tta-config-part">
<div class="tta-config-body">

  <p class="tta-breadcrumb">{{localize "TTA.Config.Breadcrumb"}} <strong>{{localize "TTA.Config.Open"}}</strong> &middot; {{localize "TTA.Config.DraftHint"}}</p>

  <section class="tta-section">
    <div class="tta-section-head">
      <span class="tta-kicker">{{localize "TTA.Presets.Heading"}}</span>
      <span class="tta-meta">{{localize "TTA.Presets.Hint"}}</span>
    </div>
    <div class="tta-inline-row">
      <label class="tta-grow">
        <span class="tta-sr-only">{{localize "TTA.Presets.Choose"}}</span>
        <select data-preset-select aria-label="{{localize "TTA.Presets.Choose"}}">
          <option value="">{{localize "TTA.Presets.ChoosePlaceholder"}}</option>
          {{#each presetChoices}}
            <option value="{{value}}">{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="tta-checkbox">
        <input type="checkbox" data-preset-holidays checked>
        <span>{{localize "TTA.Presets.IncludeHolidays"}}</span>
      </label>
      <button type="button" class="tta-compact" data-action="loadPreset">{{localize "TTA.Presets.Load"}}</button>
    </div>
    <p class="tta-hint" data-preset-description>{{presetDescription}}</p>
  </section>

  {{#if hasPendingHolidays}}
    <div class="tta-panel">
      <div class="tta-panel-head">
        <div>
          <span class="tta-kicker">{{localize "TTA.Presets.StagedHeading"}}</span>
          <p>{{localize "TTA.Presets.PendingHolidays"}} (<span class="tta-num">{{pendingHolidayCount}}</span>)</p>
        </div>
        <button type="button" class="tta-ghost tta-compact" data-action="discardHolidays">{{localize "TTA.Presets.DiscardHolidays"}}</button>
      </div>
    </div>
  {{/if}}

  {{#if hasPendingImport}}
    <div class="tta-panel">
      <div class="tta-panel-head">
        <div>
          <span class="tta-kicker">{{localize "TTA.Import.StagedHeading"}}</span>
          <p>{{localize "TTA.Import.PendingEvents"}} (<span class="tta-num">{{pendingEventCount}}</span>)</p>
        </div>
        <button type="button" class="tta-ghost tta-compact" data-action="discardImport">{{localize "TTA.Import.DiscardEvents"}}</button>
      </div>
    </div>
  {{/if}}

  {{#if errors.length}}
    <div class="tta-panel tta-panel-error" role="alert">
      <span class="tta-kicker">{{localize "TTA.Config.ErrorsHeading"}}</span>
      <ul>{{#each errors}}<li>&middot; {{this}}</li>{{/each}}</ul>
    </div>
  {{/if}}

  {{#if warnings.length}}
    <div class="tta-panel tta-panel-warning">
      <span class="tta-kicker">{{localize "TTA.Config.WarningsHeading"}}</span>
      <ul>{{#each warnings}}<li>&middot; {{this}}</li>{{/each}}</ul>
    </div>
  {{/if}}

  <section class="tta-section">
    <div class="tta-section-head">
      <span class="tta-kicker">{{localize "TTA.Config.StructureHeading"}}</span>
      <span class="tta-meta">{{localize "TTA.Config.StructureHint"}}</span>
    </div>
    <div class="tta-field-grid">
      <div class="tta-field">
        <label for="tta-months">{{localize "TTA.Config.MonthsPerYear"}}</label>
        <input id="tta-months" type="number" name="monthsPerYear" data-structure
               min="{{limits.MONTHS_MIN}}" max="{{limits.MONTHS_MAX}}" step="1" value="{{calendar.monthsPerYear}}">
      </div>
      <div class="tta-field">
        <label for="tta-days">{{localize "TTA.Config.DaysPerMonth"}}</label>
        <div class="tta-inline-row">
          <input id="tta-days" type="number" name="daysPerMonth"
                 min="{{limits.DAYS_MIN}}" max="{{limits.DAYS_MAX}}" step="1" value="{{calendar.daysPerMonth}}">
          <button type="button" class="tta-ghost tta-compact" data-action="uniformDays">{{localize "TTA.Config.ApplyToAllMonths"}}</button>
        </div>
        <span class="tta-meta">{{localize "TTA.Config.DaysPerMonthHint"}}</span>
      </div>
      <div class="tta-field">
        <label for="tta-weekday-offset">{{localize "TTA.Config.FirstWeekday"}}</label>
        <select id="tta-weekday-offset" name="weekdayOffset">
          {{#each weekdayChoices}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <span class="tta-meta">{{localize "TTA.Config.FirstWeekdayHint"}}</span>
      </div>
      <div class="tta-field">
        <label for="tta-weekdays">{{localize "TTA.Config.WeekdayCount"}}</label>
        <input id="tta-weekdays" type="number" name="weekdayCount" data-structure
               min="{{limits.WEEKDAYS_MIN}}" max="{{limits.WEEKDAYS_MAX}}" step="1" value="{{weekdayCount}}">
      </div>
    </div>
  </section>

  <section class="tta-section">
    <div class="tta-section-head">
      <span class="tta-kicker">{{localize "TTA.Config.CurrentDateHeading"}}</span>
    </div>
    <div class="tta-field-grid tta-field-grid-date">
      <div class="tta-field">
        <label for="tta-current-year">{{localize "TTA.Common.Year"}}</label>
        <input id="tta-current-year" type="number" name="currentYear" min="{{limits.YEAR_MIN}}" step="1" value="{{calendar.currentDate.year}}">
      </div>
      <div class="tta-field">
        <label for="tta-current-month">{{localize "TTA.Common.Month"}}</label>
        <select id="tta-current-month" name="currentMonth">
          {{#each monthChoices}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="tta-field">
        <label for="tta-current-day">{{localize "TTA.Common.Day"}}</label>
        <input id="tta-current-day" type="number" name="currentDay" min="1" max="{{currentMonthDays}}" step="1" value="{{calendar.currentDate.day}}">
      </div>
    </div>
    <div class="tta-field-grid">
      <div class="tta-field">
        <label for="tta-year-prefix">{{localize "TTA.Config.YearPrefix"}}</label>
        <input id="tta-year-prefix" type="text" name="yearPrefix" maxlength="{{limits.YEAR_AFFIX_MAX}}" value="{{calendar.yearPrefix}}">
      </div>
      <div class="tta-field">
        <label for="tta-year-suffix">{{localize "TTA.Config.YearSuffix"}}</label>
        <input id="tta-year-suffix" type="text" name="yearSuffix" maxlength="{{limits.YEAR_AFFIX_MAX}}" value="{{calendar.yearSuffix}}">
      </div>
      <div class="tta-field">
        <span class="tta-meta">{{localize "TTA.Config.YearAffixHint"}} <span class="tta-key">{{yearPreview}}</span></span>
      </div>
    </div>
  </section>

  <section class="tta-section">
    <div class="tta-section-head">
      <span class="tta-kicker">{{localize "TTA.Config.MonthNames"}}</span>
      <button type="button" class="tta-ghost tta-compact" data-action="resetNames">{{localize "TTA.Config.ResetNames"}}</button>
    </div>
    <p class="tta-hint">{{localize "TTA.Config.MonthLengthHint"}}</p>
    <div class="tta-name-grid">
      {{#each monthNames}}
        <label class="tta-name-field">
          <span class="tta-name-index">{{number}}</span>
          <input type="text" data-month-name value="{{name}}"
                 aria-label="{{localize "TTA.Config.MonthNameAria"}} {{number}}">
          <input type="number" class="tta-month-days" data-month-days data-structure
                 min="{{../limits.DAYS_MIN}}" max="{{../limits.DAYS_MAX}}" step="1" value="{{length}}"
                 aria-label="{{localize "TTA.Config.MonthLengthAria"}} {{number}}">
        </label>
      {{/each}}
    </div>
  </section>

  <section class="tta-section">
    <div class="tta-section-head">
      <span class="tta-kicker">{{localize "TTA.Config.WeekdayNames"}}</span>
    </div>
    <div class="tta-weekday-grid">
      {{#each weekdayNames}}
        <input type="text" data-weekday-name value="{{name}}"
               aria-label="{{localize "TTA.Config.WeekdayNameAria"}} {{number}}">
      {{/each}}
    </div>
  </section>

  <section class="tta-section">
    <div class="tta-section-head">
      <span class="tta-kicker">{{localize "TTA.Config.AgesHeading"}}</span>
      <span class="tta-meta">{{localize "TTA.Config.AgesHint"}}</span>
    </div>

    {{#if hasAges}}
      <ol class="tta-row-editor">
        {{#each ages}}
          <li class="tta-editor-row" data-age-row data-age-id="{{id}}" style="--tta-tint: {{color}}">
            <div class="tta-editor-main">
              <label class="tta-grow">
                <span>{{localize "TTA.Ages.Name"}}</span>
                <input type="text" data-field="name" value="{{name}}">
              </label>
              <label>
                <span>{{localize "TTA.Ages.StartYear"}}</span>
                <input type="number" data-field="startYear" min="1" step="1" value="{{startYear}}">
              </label>
              <label>
                <span>{{localize "TTA.Ages.Duration"}}</span>
                <input type="number" data-field="durationYears" min="1" step="1" value="{{durationYears}}">
              </label>
              <p class="tta-editor-derived">
                <span>{{localize "TTA.Ages.EndYear"}}</span>
                <strong class="tta-num">{{endYear}}</strong>
              </p>
              <label class="tta-color">
                <span>{{localize "TTA.Ages.Color"}}</span>
                <input type="color" data-field="color" value="{{color}}">
              </label>
            </div>

            <label class="tta-editor-description">
              <span>{{localize "TTA.Ages.Description"}}</span>
              <textarea data-field="description" rows="2">{{description}}</textarea>
            </label>

            <div class="tta-editor-footer">
              <label class="tta-checkbox">
                <input type="checkbox" data-field="playerVisible" {{#if playerVisible}}checked{{/if}}>
                <span>{{localize "TTA.Ages.PlayerVisible"}}</span>
              </label>
              <span class="tta-editor-controls">
                <button type="button" class="tta-icon-only" data-action="moveAgeUp"
                        data-tooltip="{{localize "TTA.Common.MoveUp"}}" aria-label="{{localize "TTA.Common.MoveUp"}}">
                  <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                </button>
                <button type="button" class="tta-icon-only" data-action="moveAgeDown"
                        data-tooltip="{{localize "TTA.Common.MoveDown"}}" aria-label="{{localize "TTA.Common.MoveDown"}}">
                  <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
                </button>
                <button type="button" class="tta-icon-only tta-danger" data-action="removeAge"
                        data-tooltip="{{localize "TTA.Common.Remove"}}" aria-label="{{localize "TTA.Common.Remove"}}">
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              </span>
            </div>
          </li>
        {{/each}}
      </ol>
    {{else}}
      <p class="tta-empty">{{localize "TTA.Config.NoAges"}}</p>
    {{/if}}

    <div><button type="button" data-action="addAge">{{localize "TTA.Config.AddAge"}}</button></div>
  </section>

  <section class="tta-section">
    <div class="tta-section-head">
      <span class="tta-kicker">{{localize "TTA.Parties.Heading"}}</span>
      <span class="tta-meta">{{localize "TTA.Parties.Hint"}}</span>
    </div>

    {{#if hasParties}}
      <p class="tta-hint">{{localize "TTA.Parties.ActiveHint"}}</p>
      <ol class="tta-row-editor">
        {{#each parties}}
          <li class="tta-editor-row" data-party-row data-party-id="{{id}}" style="--tta-tint: {{color}}">
            <div class="tta-editor-main">
              <label class="tta-grow">
                <span>{{localize "TTA.Parties.Name"}}</span>
                <input type="text" data-field="name" maxlength="{{../limits.PARTY_NAME_MAX}}" value="{{name}}">
              </label>
              <label class="tta-color">
                <span>{{localize "TTA.Parties.Color"}}</span>
                <input type="color" data-field="color" value="{{color}}">
              </label>
              <p class="tta-editor-derived">
                <span>{{localize "TTA.Parties.StandingAt"}}</span>
                <strong class="tta-num">{{dateLabel}}</strong>
              </p>
            </div>

            <label class="tta-editor-description">
              <span>{{localize "TTA.Parties.Members"}}</span>
              {{#if ../hasPlayers}}
                <select multiple data-field="members" class="tta-members" size="{{../memberRows}}"
                        aria-label="{{localize "TTA.Parties.Members"}} {{name}}">
                  {{#each memberChoices}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
                <span class="tta-meta">{{localize "TTA.Parties.MembersHint"}}</span>
              {{else}}
                <span class="tta-meta">{{localize "TTA.Parties.NoPlayers"}}</span>
              {{/if}}
            </label>

            <div class="tta-editor-footer">
              <label class="tta-checkbox">
                <input type="radio" name="activeParty" value="{{id}}" {{#if isActive}}checked{{/if}}>
                <span>{{localize "TTA.Parties.Active"}}</span>
              </label>
              <span class="tta-editor-controls">
                <button type="button" class="tta-icon-only" data-action="movePartyUp"
                        data-tooltip="{{localize "TTA.Common.MoveUp"}}" aria-label="{{localize "TTA.Common.MoveUp"}}">
                  <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                </button>
                <button type="button" class="tta-icon-only" data-action="movePartyDown"
                        data-tooltip="{{localize "TTA.Common.MoveDown"}}" aria-label="{{localize "TTA.Common.MoveDown"}}">
                  <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
                </button>
                <button type="button" class="tta-icon-only tta-danger" data-action="removeParty"
                        data-tooltip="{{localize "TTA.Common.Remove"}}" aria-label="{{localize "TTA.Common.Remove"}}">
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              </span>
            </div>
          </li>
        {{/each}}
      </ol>
    {{else}}
      <p class="tta-empty">{{localize "TTA.Parties.NoParties"}}</p>
    {{/if}}

    {{#if canAddParty}}
      <div><button type="button" data-action="addParty">{{localize "TTA.Parties.AddParty"}}</button></div>
    {{else}}
      <p class="tta-hint">{{localize "TTA.Parties.LimitHint" max=partiesMax}}</p>
    {{/if}}
  </section>

  <section class="tta-section">
    <div class="tta-section-head">
      <span class="tta-kicker">{{localize "TTA.Moons.Heading"}}</span>
      <span class="tta-meta">{{localize "TTA.Moons.Hint"}}</span>
    </div>

    {{#if hasMoons}}
      <ol class="tta-row-editor">
        {{#each moons}}
          <li class="tta-editor-row" data-moon-row data-moon-id="{{id}}" style="--tta-tint: {{color}}">
            <div class="tta-editor-main">
              <span class="tta-moon-preview" aria-hidden="true">
                <span class="tta-moon-disc {{#if waxing}}tta-waxing{{else}}tta-waning{{/if}} {{#if gibbous}}tta-gibbous{{/if}}"
                      style="--tta-moon-color: {{color}}; --tta-illumination: {{illumination}}; --tta-terminator: {{terminator}}"></span>
              </span>
              <label class="tta-grow">
                <span>{{localize "TTA.Moons.Name"}}</span>
                <input type="text" data-field="name" value="{{name}}">
              </label>
              <label>
                <span>{{localize "TTA.Moons.CycleLength"}}</span>
                <input type="number" data-field="cycleLength" min="{{../limits.MOON_CYCLE_MIN}}" max="{{../limits.MOON_CYCLE_MAX}}" step="any" value="{{cycleLength}}">
              </label>
              <label>
                <span>{{localize "TTA.Moons.Offset"}}</span>
                <input type="number" data-field="offset" min="0" max="{{offsetMax}}" step="1" value="{{offset}}">
              </label>
              <label>
                <span>{{localize "TTA.Moons.PhaseCount"}}</span>
                <select data-field="phaseCount">
                  {{#each phaseChoices}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </label>
              <label class="tta-color">
                <span>{{localize "TTA.Moons.Color"}}</span>
                <input type="color" data-field="color" value="{{color}}">
              </label>
            </div>

            <div class="tta-editor-footer">
              <p class="tta-editor-derived">
                <span>{{localize "TTA.Moons.PhaseToday"}}</span>
                <strong>{{phaseLabel}}</strong>
              </p>
              <label class="tta-checkbox">
                <input type="checkbox" data-field="showInGrid" {{#if showInGrid}}checked{{/if}}>
                <span>{{localize "TTA.Moons.ShowInGrid"}}</span>
              </label>
              <label class="tta-checkbox">
                <input type="checkbox" data-field="playerVisible" {{#if playerVisible}}checked{{/if}}>
                <span>{{localize "TTA.Moons.PlayerVisible"}}</span>
              </label>
              <span class="tta-editor-controls">
                <button type="button" class="tta-icon-only" data-action="moveMoonUp"
                        data-tooltip="{{localize "TTA.Common.MoveUp"}}" aria-label="{{localize "TTA.Common.MoveUp"}}">
                  <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                </button>
                <button type="button" class="tta-icon-only" data-action="moveMoonDown"
                        data-tooltip="{{localize "TTA.Common.MoveDown"}}" aria-label="{{localize "TTA.Common.MoveDown"}}">
                  <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
                </button>
                <button type="button" class="tta-icon-only tta-danger" data-action="removeMoon"
                        data-tooltip="{{localize "TTA.Common.Remove"}}" aria-label="{{localize "TTA.Common.Remove"}}">
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              </span>
            </div>
          </li>
        {{/each}}
      </ol>
    {{else}}
      <p class="tta-empty">{{localize "TTA.Moons.NoMoons"}}</p>
    {{/if}}

    {{#if canAddMoon}}
      <div><button type="button" data-action="addMoon">{{localize "TTA.Moons.AddMoon"}}</button></div>
    {{else}}
      <p class="tta-hint">{{localize "TTA.Moons.LimitHint" max=moonsMax}}</p>
    {{/if}}
  </section>

  <section class="tta-section">
    <div class="tta-section-head">
      <span class="tta-kicker">{{localize "TTA.Import.Heading"}}</span>
    </div>
    <div class="tta-inline-row">
      <label class="tta-checkbox">
        <input type="checkbox" data-export-events checked>
        <span>{{localize "TTA.Import.IncludeEvents"}}</span>
      </label>
      <button type="button" class="tta-compact" data-action="exportCalendar">{{localize "TTA.Import.Export"}}</button>
      <button type="button" class="tta-compact" data-action="importCalendar">{{localize "TTA.Import.Import"}}</button>
      <span class="tta-meta">{{localize "TTA.Import.NotesExcluded"}}</span>
    </div>
  </section>
</div>

<footer class="tta-form-footer">
  <span class="tta-meta">
    {{#if folderName}}
      {{localize "TTA.Config.FolderLinked"}} <span class="tta-key">{{folderName}}</span>
    {{else}}
      {{localize "TTA.Config.FolderMissing"}}
    {{/if}}
  </span>
  <button type="button" class="tta-ghost tta-compact" data-action="repairFolder">{{localize "TTA.Config.RepairFolder"}}</button>
  <button type="submit" class="tta-primary">{{localize "TTA.Config.Save"}}</button>
</footer>
</div>
