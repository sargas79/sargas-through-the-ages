<div class="tta-form-part">
<div class="tta-form-body">

  <p class="tta-form-context">
    <span>{{#if isMonthNote}}{{localize "TTA.Notes.MonthScope"}}{{else}}{{localize "TTA.Notes.DayScope"}}{{/if}} {{dateLabel}}</span>
    <span class="tta-key" data-tooltip="{{localize "TTA.Notes.DateKeyTooltip"}}">{{dateKey}}</span>
  </p>

  <div class="tta-field">
    <label for="tta-note-title">{{localize "TTA.Notes.TitleField"}}</label>
    <input id="tta-note-title" type="text" name="title" value="{{note.title}}" required
           placeholder="{{localize "TTA.Notes.TitlePlaceholder"}}">
  </div>

  <div class="tta-field">
    <span id="tta-note-content-label">{{localize "TTA.Notes.ContentField"}}</span>
    <div data-editor-host class="tta-editor-host" aria-labelledby="tta-note-content-label"></div>
  </div>

  {{#if canSetVisibility}}
    <div class="tta-field-grid">
      <div class="tta-field">
        <label for="tta-note-visibility">{{localize "TTA.Notes.VisibilityField"}}</label>
        <select id="tta-note-visibility" name="visibility">
          {{#each visibilityChoices}}
            <option value="{{value}}" {{#if (ttaEq value ../visibility)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
      {{#if partyChoices}}
        <div class="tta-field">
          <label for="tta-note-party">{{localize "TTA.NoteEditor.PartyField"}}</label>
          <select id="tta-note-party" name="partyId">
            {{#each partyChoices}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          <span class="tta-meta">{{localize "TTA.NoteEditor.PartyFieldHint"}}</span>
        </div>
      {{/if}}
    </div>
  {{else if shareWithParty}}
    {{!-- Unticked, the box still submits "false": a hidden input carries it, so
          a player clearing the box can take a note back from their party. --}}
    <input type="hidden" name="shareWithParty" value="false">
    <label class="tta-checkbox">
      <input type="checkbox" name="shareWithParty" value="true" {{#if shareWithParty.checked}}checked{{/if}}>
      <span>{{localize "TTA.NoteEditor.ShareWithParty" name=shareWithParty.name}}</span>
    </label>
  {{/if}}

  <p class="tta-hint">{{privacyHint}}</p>
</div>

<footer class="tta-form-footer">
  <button type="submit" class="tta-primary">
    {{#if note}}{{localize "TTA.Common.SaveChanges"}}{{else}}{{localize "TTA.Notes.Create"}}{{/if}}
  </button>
</footer>
</div>
