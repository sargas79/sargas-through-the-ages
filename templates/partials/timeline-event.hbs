<li class="tta-timeline-event" style="--tta-tint: {{color}}">
  <span class="tta-event-dot" aria-hidden="true"></span>

  <div class="tta-event-body">
    <div class="tta-event-title">
      <i class="{{icon}}" aria-hidden="true"></i> {{title}}
    </div>

    <div class="tta-event-meta">
      <span class="tta-key">{{dateLabel}}</span>
      <span class="tta-tag {{#unless isPlayerVisible}}tta-tag-accent{{/unless}}">{{visibilityLabel}}</span>
      {{#if partyName}}
        <span class="tta-tag tta-tag-party" style="--tta-tint: {{partyColor}}">{{partyName}}</span>
      {{/if}}
      {{#if showOrigin}}
        {{#if sourceAvailable}}
          <button type="button" class="tta-ghost tta-compact" data-action="openSource" data-uuid="{{sourceUuid}}"
                  data-tooltip="{{localize "TTA.Timeline.OriginTooltip"}}">
            {{localize "TTA.Timeline.Origin"}} &#x2197;
          </button>
        {{else}}
          <span class="tta-meta">{{localize "TTA.Timeline.SourceUnavailable"}}</span>
        {{/if}}
      {{/if}}
    </div>

    {{#if enriched}}<div class="tta-event-content">{{{enriched}}}</div>{{/if}}
  </div>

  {{#if @root.canManage}}
    <span class="tta-event-actions">
      <button type="button" class="tta-icon-only" data-action="editEvent" data-event-id="{{id}}"
              data-tooltip="{{localize "TTA.Common.Edit"}}" aria-label="{{localize "TTA.Common.Edit"}}">
        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
      </button>
      <button type="button" class="tta-icon-only tta-danger" data-action="deleteEvent" data-event-id="{{id}}"
              data-tooltip="{{localize "TTA.Common.Delete"}}" aria-label="{{localize "TTA.Common.Delete"}}">
        <i class="fa-solid fa-trash" aria-hidden="true"></i>
      </button>
    </span>
  {{/if}}
</li>
