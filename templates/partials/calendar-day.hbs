{{#if empty}}
  {{!-- A leading blank still occupies its column: hiding it would make the row
        appear to have fewer columns than the grid does. --}}
  <div class="tta-day-empty" role="gridcell" aria-label="{{localize "TTA.Calendar.NoDayInCell"}}"></div>
{{else}}
  <div class="tta-day {{#if isCurrent}}tta-day-current{{/if}} {{#if isSelected}}tta-day-selected{{/if}}" role="gridcell">
    <button type="button"
            class="tta-day-button"
            data-action="selectDay"
            data-day="{{day}}"
            aria-pressed="{{#if isSelected}}true{{else}}false{{/if}}"
            aria-label="{{label}}">
      <span class="tta-day-number">{{day}}</span>
      {{!-- Up to three note dots then up to two event dots: the exact counts
            live in the cell's aria-label, not in the marks. --}}
      <span class="tta-day-marks" aria-hidden="true">
        {{#each noteDots}}<span class="tta-dot-note"></span>{{/each}}
        {{#each eventDots}}<span class="tta-dot-event"></span>{{/each}}
      </span>
      {{#if moons.length}}
        <span class="tta-day-moons" aria-hidden="true">
          {{#each moons}}
            <span class="tta-moon-disc tta-moon-mini {{#if waxing}}tta-waxing{{else}}tta-waning{{/if}} {{#if gibbous}}tta-gibbous{{/if}}"
                  style="--tta-moon-color: {{color}}; --tta-illumination: {{illumination}}; --tta-terminator: {{terminator}}"></span>
          {{/each}}
        </span>
      {{/if}}
      {{#if parties.length}}
        {{!-- Other parties standing on this day, each in its own colour. The
              shown party's own day is the tinted cell, not a mark. --}}
        <span class="tta-day-parties">
          {{#each parties}}
            <span class="tta-party-mark" style="--tta-tint: {{color}}" aria-hidden="true"></span>
            <span class="tta-sr-only">{{localize "TTA.Parties.DayMarkLabel" name=name}}</span>
          {{/each}}
        </span>
      {{/if}}
      {{#if isCurrent}}<span class="tta-sr-only">{{localize "TTA.Calendar.IsCurrentDay"}}</span>{{/if}}
    </button>
  </div>
{{/if}}
